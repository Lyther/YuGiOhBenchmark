# Reference shell settings for the seat, smoke run, card refresh and probe.
# Nothing loads .env automatically; export these or put them in an MCP server's env.
YGO_HOST=koishi.momobako.com
YGO_PORT=2339
YGO_VERSION=0x1362

# The seat needs one room shared by both players: M = Bo3, TM0 = no clock,
# NF = no banlist; the part after # is the room id (19 UTF-16 units in total).
# The probe generates M,TM0,NF#yb<8 hex digits> when this is empty.
YGO_ROOM=
# Empty chooses ygobench-<4 hex digits>; two seats in one match need distinct names.
YGO_NAME=

# Optional .ydk loaded as the working deck at start.
YGO_DECK=
YGO_RUN_DIR=./runs
YGO_CARDS_DIR=./data/cards
# Longest single wait, in ms; keep it below the runtime's per-call tool timeout.
YGO_WAIT_MS=240000
# 1 also writes the raw server packets to session.bin in the run folder.
YGO_CAPTURE=0
YGO_LOG_LEVEL=info
